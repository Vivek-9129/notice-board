# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to git.

# Get this from TiDB Cloud → Clusters → Connect → Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED&sslaccept=strict
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED&sslaccept=strict"
